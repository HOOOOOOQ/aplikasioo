# Salin menjadi .env.web lalu isi nilainya. Berkas .env.web TIDAK di-commit.
#
# Ambil dari Supabase Dashboard → Project Settings → API:
#   SUPABASE_URL      = Project URL, contoh https://abcdefghijklmnop.supabase.co
#   SUPABASE_ANON_KEY = kunci "anon public" (boleh ada di klien; RLS yang melindungi data)
#
# Jangan pernah menaruh kunci "service_role" di sini — kunci itu melewati RLS
# dan tidak boleh dipakai di aplikasi klien.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opsional
# WEB_PORT=8080
# USE_PATH_URL_STRATEGY=1
